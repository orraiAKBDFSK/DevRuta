root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{java,sql}]
indent_size = 4

# El código generado por Spring Initializr usa tabuladores en Java.
[*.java]
indent_style = tab

[*.py]
indent_size = 4

[{mvnw.cmd,*.ps1,*.bat}]
end_of_line = crlf

# Copia este archivo a ".env" (que NO se sube al repositorio) para cambiar los valores de desarrollo.
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma
# Puerto en tu máquina. Cámbialo (p. ej. 5433) si ya tienes otro PostgreSQL usando el 5432.
# Si lo cambias, exporta la misma variable antes de arrancar la API con el perfil "dev".
POSTGRES_PORT=5432
# Mailpit (correo falso de desarrollo): puertos en tu máquina. Cámbialos si están ocupados.
# Si cambias MAILPIT_SMTP_PORT, exporta la misma variable antes de arrancar la API con el perfil "dev".
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Token compartido entre la API y el runner (mínimo 16 caracteres). El valor por defecto es SOLO para desarrollo.
RUNNER_TOKEN=dev-only-runner-token-change-me

# Imagen del sandbox de Python: lo único que contiene es el intérprete y el arnés.
# El runner la lanza con red desactivada, sistema de archivos de solo lectura y sin privilegios (ver executor.py).
FROM python:3.13-slim

# Sin pip ni herramientas de compilación que el código del estudiante pudiera usar.
RUN python -m pip uninstall -y pip setuptools wheel 2>/dev/null || true \
    && rm -rf /usr/local/lib/python3.13/ensurepip /root/.cache

COPY harness.py /opt/harness.py
RUN chmod 0444 /opt/harness.py

USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "/opt/harness.py"]
